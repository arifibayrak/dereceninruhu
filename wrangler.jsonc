{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dereceninruhu",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Must match where the app is served (Better Auth baseURL + trusted origin).
    "BETTER_AUTH_URL": "https://dereceninruhu.com",
    // Canlı-transkript tarayıcı eklentisi için CORS allowlist'i (virgülle çoklu).
    // Sabit id, extension/wxt.config.ts'teki manifest `key`'inden türetilir.
    // Mağazadan yayınlarsan, mağaza id'sini de virgülle buraya ekle.
    "EXTENSION_ORIGIN": "chrome-extension://chgfdngapkpilefnccpijdfomddeepjh"
  },
  "routes": [
    { "pattern": "dereceninruhu.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dereceninruhu-db",
      "database_id": "99be7c0d-45d7-4f79-adb0-57b32fd1a2a1",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  // Görüşme kayıtları (AI transkript hattı). Uzak dağıtımdan önce hesapta R2'yi
  // etkinleştirip bucket'ı oluşturun: `wrangler r2 bucket create dereceninruhu-files`.
  // Yerel geliştirmede Miniflare R2'yi simüle eder; hesap etkinleştirmesi gerekmez.
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "dereceninruhu-files"
    }
  ]
  // OPENROUTER_API_KEY bir secret'tır (wrangler.jsonc'a yazılmaz): yerelde .dev.vars,
  // dağıtımda `wrangler secret put OPENROUTER_API_KEY`.
  // Cron triggers (haftalık roll-up, aylık fatura) added later with a scheduled handler.
}

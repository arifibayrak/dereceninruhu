{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dereceninruhu",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Must match where the app is served (Better Auth baseURL + trusted origin).
    // Update to https://dereceninruhu.com once the custom domain is bound.
    "BETTER_AUTH_URL": "https://dereceninruhu.aib25.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dereceninruhu-db",
      "database_id": "99be7c0d-45d7-4f79-adb0-57b32fd1a2a1",
      "migrations_dir": "drizzle/migrations"
    }
  ]
  // R2 binding removed until R2 is enabled on the account (Cloudflare dashboard).
  // Nothing uses R2 yet; re-add when file storage (makbuz/içerik) ships.
  // Cron triggers (haftalık roll-up, aylık fatura) added later with a scheduled handler.
}
